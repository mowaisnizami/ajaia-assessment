# Use a specific immutable SHA tag for a repeatable release after GitHub Actions is green.
# Example: IMAGE_TAG=sha-8da7dfe
IMAGE_TAG=latest

# Must exactly match the public hostname configured in Cloudflare and Nginx Proxy Manager.
PUBLIC_ORIGIN=https://app.example.com

# Existing PostgreSQL container's DNS name/alias on the nginxproxymanager network.
# This is a Docker container name, not localhost and not the server's public IP.
POSTGRES_HOST=postgres
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=replace-with-a-strong-password

# Existing external Docker network name.
NPM_NETWORK=nginxproxymanager
